# ─────────────────────────────────────────────
#  Sathi — Web (Vercel) environment
#  Copy to .env.local and fill in. Phase 1 needs none of these to
#  view the landing page; they come into play from Phase 2 onward.
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2 — auth + data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, never exposed to the browser

# Resend (Phase 2 — branded verification emails via your connected domain)
RESEND_API_KEY=
EMAIL_FROM="Sathi <hello@yourdomain.com>"

# Internal API to the Python bot engine on Render (Phase 3 — Telegram login, etc.)
BOT_ENGINE_URL=https://your-render-service.onrender.com
INTERNAL_API_TOKEN=            # shared secret; must match the engine's token
