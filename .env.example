# ─────────────────────────────────────────────
#  Autogram — Web env. Set the same values in Vercel
#  (Project → Settings → Environment Variables), then redeploy.
# ─────────────────────────────────────────────

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bot engine (Render) — used server-side to connect Telegram / save AI keys.
BOT_ENGINE_URL=https://autogram-bot-code.onrender.com
# MUST match the engine's INTERNAL_API_TOKEN exactly.
INTERNAL_API_TOKEN=

# Super-admin: comma-separated emails that can open /admin (your login email).
ADMIN_EMAIL=you@example.com
